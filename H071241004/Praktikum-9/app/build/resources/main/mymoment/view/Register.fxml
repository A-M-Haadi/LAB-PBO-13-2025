<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox alignment="TOP_CENTER" maxHeight="500.0" maxWidth="350.0" minHeight="500.0" minWidth="350.0" prefHeight="500.0" prefWidth="350.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mymoment.controller.RegisterController">
    <children>
        <VBox alignment="CENTER" spacing="5.0">
            <children>
                <Label styleClass="title-label" text="MyMoment" />
                <Label styleClass="subtitle-label" text="Create Your Account" />
            </children>
            <VBox.margin>
                <Insets bottom="15.0" />
            </VBox.margin>
        </VBox>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
            <content>
                <VBox alignment="TOP_CENTER" spacing="15.0">
                    <padding>
                        <Insets right="5.0" />
                    </padding>
                    <children>
                        <ImageView fx:id="profileImageView" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" styleClass="profile-image-view">
                            <clip>
                                <Circle centerX="60.0" centerY="60.0" radius="60.0" />
                            </clip>
                        </ImageView>

                        <Button fx:id="uploadButton" mnemonicParsing="false" onAction="#handleUploadButton" styleClass="button-upload" text="Upload Profile Photo" />

                        <VBox spacing="10.0">
                            <children>
                                <TextField fx:id="nickNameField" promptText="Nickname" styleClass="text-field" />
                                <TextField fx:id="fullNameField" promptText="Full Name" styleClass="text-field" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>

        <Button fx:id="submitButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleSubmitButton" text="Submit">
            <VBox.margin>
                <Insets top="15.0" />
            </VBox.margin>
        </Button>
    </children>

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
</VBox>